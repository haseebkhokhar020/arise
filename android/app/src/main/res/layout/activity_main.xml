<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/arise_void"
    android:fitsSystemWindows="true"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingBottom="10dp">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/arise_text"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/latency_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/arise_accent"
            android:textSize="10sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_gear"
            android:contentDescription="@string/settings_title"
            app:tint="@color/arise_text" />
    </LinearLayout>

    <!-- dimensional logo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.05"
        android:minHeight="160dp">

        <com.arise.assistant.ui.AriseLogoView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/phase_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_debug"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Idle"
            android:textColor="@color/arise_text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.18" />
    </FrameLayout>

    <!-- status -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Say “Arise”…"
        android:textColor="@color/arise_text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/task_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/arise_accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/wake_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_power"
                app:tint="@color/arise_accent" />
            <TextView
                android:id="@+id/wake_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hands-free off"
                android:textColor="@color/arise_text_dim"
                android:textSize="11sp"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:background="@drawable/bg_round_btn"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/mic_in_use"
            android:elevation="6dp"
            app:tint="@color/white" />

        <LinearLayout
            android:id="@+id/stop_pill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_stop"
                app:tint="@color/arise_error" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop"
                android:textColor="@color/arise_error"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- confirmation card -->
    <LinearLayout
        android:id="@+id/confirm_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_confirm"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/confirm_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/arise_text"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/confirm_yes"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Yes"
                android:textColor="@color/arise_accent" />
            <Button
                android:id="@+id/confirm_no"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No"
                android:textColor="@color/arise_error" />
        </LinearLayout>
    </LinearLayout>

    <!-- conversation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/chat_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Tap the mic and say “Arise, open YouTube”, or type below.\nExample: “Send Ali a WhatsApp message saying I’m on my way”"
            android:textColor="@color/arise_text_dim"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- debug -->
    <TextView
        android:id="@+id/debug_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_debug"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:padding="8dp"
        android:text=""
        android:textColor="#7A86B5"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input"
        android:padding="4dp">

        <EditText
            android:id="@+id/input_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Ask or type a command…"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:paddingLeft="14dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/arise_text"
            android:textColorHint="@color/arise_text_dim"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_send"
            android:src="@drawable/ic_send"
            android:contentDescription="Send"
            app:tint="@color/arise_void" />
    </LinearLayout>
</LinearLayout>
