<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Arise" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/arise_void</item>
        <item name="android:statusBarColor">@color/arise_void</item>
        <item name="android:navigationBarColor">@color/arise_void</item>
        <item name="colorPrimary">@color/arise_core</item>
        <item name="colorPrimaryDark">@color/arise_void</item>
        <item name="colorAccent">@color/arise_accent</item>
        <item name="android:textColorPrimary">@color/arise_text</item>
        <item name="android:textColorSecondary">@color/arise_text_dim</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AriseButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/arise_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
